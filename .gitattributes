*.obj    binary
*.blend  binary
*.dae    binary
*.3ds    binary
*.glb    binary
*.gltf   binary

*.png    binary
*.jpg    binary
*.jpeg   binary
*.tga    binary
*.tif    binary
*.tiff   binary
*.psd    binary
*.bmp    binary
*.gif    binary
*.exr    binary
*.hdr    binary
*.cubemap binary

*.wav    binary
*.mp3    binary
*.ogg    binary
*.aif    binary
*.mp4    binary
*.mov    binary
*.webm   binary

*.ttf    binary
*.otf    binary
