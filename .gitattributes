# Normalisation des fins de ligne par défaut
* text=auto

# -------------------------------------------------------------
# Assets Unity sérialisés en YAML (Force Text) — toujours en LF,
# c'est ce que Unity écrit nativement, même sous Windows
# -------------------------------------------------------------
*.unity           text eol=lf
*.prefab          text eol=lf
*.asset           text eol=lf
*.mat             text eol=lf
*.meta            text eol=lf
*.anim            text eol=lf
*.controller      text eol=lf
*.overrideController text eol=lf
*.physicMaterial  text eol=lf
*.physicsMaterial text eol=lf
*.playable        text eol=lf
*.mask            text eol=lf
*.brush           text eol=lf
*.flare           text eol=lf
*.fontsettings    text eol=lf
*.guiskin         text eol=lf
*.giparams        text eol=lf
*.renderTexture   text eol=lf
*.lighting        text eol=lf
*.mixer           text eol=lf
*.terrainlayer    text eol=lf
*.signal          text eol=lf
*.shadervariants  text eol=lf
*.spriteatlas     text eol=lf

# Code et configuration
*.cs     text diff=csharp
*.shader text
*.cginc  text
*.hlsl   text
*.compute text
*.asmdef text
*.json   text
*.md     text
*.xml    text
*.yml    text

# -------------------------------------------------------------
# Binaires : pas de conversion de fins de ligne, pas de diff
# -------------------------------------------------------------
